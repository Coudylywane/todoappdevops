# Stack infrastructure fournie par Ansible
# (Traefik + PostgreSQL + Prometheus + Grafana + node-exporter)
# L'application todo est déployée par GitHub Actions via docker-compose.app.yml

services:
  traefik:
    image: traefik:v3.1
    container_name: "{{ stack_name }}-traefik"
    restart: unless-stopped
    command:
      - "--configFile=/etc/traefik/traefik.yml"
    ports:
      - "80:80"            # Frontend
      - "8080:8080"        # Dashboard Traefik
      - "8081:8081"        # API backend (webapi)
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik:/etc/traefik
    networks:
      - todo-net
    labels:
      # Dashboard Traefik automatiquement exposé par api.insecure (port 8080)
      traefik.enable: "false"

  postgres:
    image: postgres:16-alpine
    container_name: "{{ stack_name }}-postgres"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - todo-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  node-exporter:
    image: prom/node-exporter:latest
    container_name: "{{ stack_name }}-node-exporter"
    restart: unless-stopped
    pid: host
    networks:
      - todo-net
    labels:
      traefik.enable: "false"

  prometheus:
    image: prom/prometheus:latest
    container_name: "{{ stack_name }}-prometheus"
    restart: unless-stopped
    volumes:
      - ./prometheus:/etc/prometheus
      - prometheus_data:/prometheus
    ports:
      - "{{ prometheus_port }}:9090"
    networks:
      - todo-net
    labels:
      traefik.enable: "true"
      traefik.http.routers.prometheus.entrypoints: "traefik"
      traefik.http.routers.prometheus.rule: "HostRegexp(`{host:.+}`) && PathPrefix(`/prometheus`)"

  grafana:
    image: grafana/grafana:latest
    container_name: "{{ stack_name }}-grafana"
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    ports:
      - "{{ grafana_port }}:3000"
    networks:
      - todo-net

networks:
  todo-net:
    name: todo-net
    driver: bridge

volumes:
  db_data:
  prometheus_data:
  grafana_data: