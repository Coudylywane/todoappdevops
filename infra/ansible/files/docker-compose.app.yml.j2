# Stack application Todo - gérée par GitHub Actions (déploiement CI/CD)
# Le réseau todo-net est créé par l'infra (Ansible).

services:
  backend:
    build:
      context: ./backend
      args:
        PORT: "{{ backend_port }}"
    container_name: "{{ stack_name }}-backend"
    restart: unless-stopped
    environment:
      PORT: "{{ backend_port }}"
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USER: "{{ postgres_user }}"
      DB_PASSWORD: "{{ postgres_password }}"
      DB_NAME: "{{ postgres_db }}"
      APP_ENV: "{{ app_env }}"
    networks:
      - todo-net
    labels:
      traefik.enable: "true"
      traefik.http.routers.backend.entrypoints: "webapi"
      traefik.http.routers.backend.rule: "HostRegexp(`{host:.+}`)"
      traefik.http.services.backend.loadbalancer.server.port: "{{ backend_port }}"
      traefik.http.routers.backend-api.entrypoints: "web"
      traefik.http.routers.backend-api.rule: "PathPrefix(`/api`)"
      traefik.http.routers.backend-api.service: "backend"

  frontend:
    build:
      context: ./frontend
      args:
        VITE_APP_ENV: "{{ app_env }}"
        VITE_APP_TITLE: "{{ _app_title }}"
    container_name: "{{ stack_name }}-frontend"
    restart: unless-stopped
    depends_on:
      - backend
    networks:
      - todo-net
    labels:
      traefik.enable: "true"
      traefik.http.routers.frontend.entrypoints: "web"
      traefik.http.routers.frontend.rule: "HostRegexp(`{host:.+}`)"
      traefik.http.services.frontend.loadbalancer.server.port: "80"

networks:
  todo-net:
    external: true